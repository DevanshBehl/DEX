# ═══════════════════════════════════════════════════
#  CELESTIAL CONTRACTS — Environment Variables
# ═══════════════════════════════════════════════════
# Copy this to .env and fill in your values:
#   cp .env.example .env
#
# ⚠️  NEVER commit your .env file or share your private key!
# ⚠️  NEVER use a wallet with real mainnet funds for development!

# Your Sepolia RPC URL (from Alchemy or Infura)
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY

# Your testing wallet private key (export from MetaMask)
PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# (Optional) Etherscan API key for contract verification
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_API_KEY

# Chainlink price feeds on Sepolia (8 decimals, used by ChainlinkOracle from Phase 3).
# Verify at https://docs.chain.link/data-feeds/price-feeds/addresses?network=ethereum&page=1#sepolia-testnet
CHAINLINK_ETH_USD_SEPOLIA=0x694AA1769357215DE4FAC081bf1f309aDC325306
CHAINLINK_BTC_USD_SEPOLIA=0x1b44F3514812d835EB1BDB0acB33d3fA3351Ee43
# No Chainlink SOL/USD feed on Sepolia, see the SOL-USD decision in phases.md (Phase 3)
