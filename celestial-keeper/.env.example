# ═══════════════════════════════════════════════════
#  CELESTIAL KEEPER — environment
# ═══════════════════════════════════════════════════
#   cp .env.example .env     (then fill in the values; .env is gitignored)
# ⚠️  Testnet keys only. Never commit .env, never paste keys into logs or chats.

# ── Chains ──
ENABLE_EVM=true
ENABLE_SOLANA=true

# ── EVM (Sepolia) ──
# RPC with eth_getLogs support (Alchemy/Infura/…). The URL may contain an API key: it is never logged.
SEPOLIA_RPC_URL=
# Private key of a whitelisted PerpEngine keeper (the deployer 0xA0c3…2322 today).
# Fill this in yourself (copy it from celestial-contracts/.env); the keeper only logs the derived address.
EVM_KEEPER_PRIVATE_KEY=
# Optional: refuse to start unless the key derives this address (defaults to deployments/sepolia.json keepers[0]).
# EVM_EXPECTED_KEEPER=0xA0c3A70806983a965e43961DE48658a9D41f2322
# Optional overrides (defaults come from deployments/sepolia.json):
# EVM_DEPLOYMENTS=../deployments/sepolia.json
# EVM_START_BLOCK=11757411          # PerpEngine deploy block; the position index is rebuilt from here
# EVM_LOG_RANGE=500                 # eth_getLogs block range (halved automatically on RPC range errors)
# EVM_MAX_BATCH=10                  # request ids per executeRequests
# EVM_CONFIRM_TIMEOUT_MS=120000
# EVM_MIN_BALANCE_ETH=0.02          # alert below this
# EVM_POLLING_MS=1000

# ── Solana (devnet) ──
# A dedicated devnet endpoint is strongly recommended; the public one rate-limits (HTTP 429).
SOLANA_RPC_URL=https://api.devnet.solana.com
# PATH to the keeper keypair file (the deployer 6DoR…y5ED today). The file is read only by the keeper process.
SOLANA_KEEPER_KEYPAIR_PATH=~/.config/solana/devnet.json
# Optional overrides:
# SOLANA_EXPECTED_KEEPER=6DoRfsEtFC2LFEEvSEuYjeNo7vJHnFrx8EzffksVy5ED
# SOLANA_IDL_PATH=../celestial-perps/src/idl/celestial_perps.json
# SOLANA_MAX_BATCH=4                # execute_request instructions per transaction
# SOLANA_CU_PER_EXECUTE=90000
# SOLANA_CONFIRM_TIMEOUT_MS=60000
# SOLANA_MIN_BALANCE_SOL=1          # alert below this

# ── Schedules (ms) ──
# EXECUTOR_INTERVAL_MS=1500
# LIQUIDATOR_INTERVAL_MS=5000
# FUNDING_INTERVAL_MS=3600000       # ±5% jitter
# HEALTH_INTERVAL_MS=300000

# ── Alerts / logs ──
# Optional: alerts are also POSTed here as JSON ({ source, alert, message, ... }).
ALERT_WEBHOOK_URL=
# LOG_LEVEL=info                    # debug | info | warn | error | alert
