# Copy to .env.local. These are public (NEXT_PUBLIC_*) and safe defaults.

# Coinbase Exchange public market data (no API key): candles + 24h stats (REST) and live ticker (WebSocket)
NEXT_PUBLIC_MARKET_REST_URL=https://api.exchange.coinbase.com
NEXT_PUBLIC_MARKET_WS_URL=wss://ws-feed.exchange.coinbase.com

# Public Sepolia RPC for read-only Chainlink oracle reads (no wallet needed)
NEXT_PUBLIC_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
