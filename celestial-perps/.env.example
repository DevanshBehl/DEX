# Copy to .env.local. EVERYTHING here is public: NEXT_PUBLIC_* values are bundled into the
# browser JavaScript. Never put a secret (private key, paid/secret API key) in a NEXT_PUBLIC_* var.

# Coinbase Exchange public market data (no API key): candles + 24h stats (REST) and live ticker (WebSocket)
NEXT_PUBLIC_MARKET_REST_URL=https://api.exchange.coinbase.com
NEXT_PUBLIC_MARKET_WS_URL=wss://ws-feed.exchange.coinbase.com

# Sepolia JSON-RPC for reads + event history (writes go through the connected wallet).
# Must allow eth_getLogs over reasonably wide block ranges; public endpoints work but are slower.
NEXT_PUBLIC_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Solana devnet RPC for reads AND for sending transactions (the wallet only signs).
# The public endpoint rate-limits (HTTP 429) and lags; a dedicated devnet endpoint is recommended.
# Use one whose key is fine to expose (a browser-restricted / domain-locked key), since it is public.
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
